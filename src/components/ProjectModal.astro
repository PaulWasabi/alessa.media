---
// Single reusable project detail modal. Content is filled at runtime from the
// clicked card's data-* attributes (see src/scripts/modal.ts).
---
<div
  id="project-modal"
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-hidden="true"
>
  <div class="modal-backdrop absolute inset-0 bg-ink/50 backdrop-blur-sm"></div>

  <div class="absolute inset-0 flex items-center justify-center p-4 sm:p-6">
    <div
      class="modal-panel relative w-full max-w-lg overflow-hidden rounded-3xl bg-white shadow-2xl"
    >
      <div class="bg-gradient h-2 w-full"></div>

      <button
        type="button"
        class="modal-close absolute right-4 top-5 flex h-9 w-9 items-center justify-center rounded-full border border-line bg-white/90 text-muted transition-colors hover:bg-surface hover:text-ink"
        aria-label="Schließen"
      >✕</button>

      <div class="p-7 sm:p-9">
        <p data-field="client" class="pr-10 text-xs font-semibold uppercase tracking-[0.2em] text-faint"></p>
        <h2 id="modal-title" data-field="title" class="mt-2 pr-6 text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl"></h2>
        <div data-field="tags" class="mt-4 flex flex-wrap gap-2"></div>
        <p data-field="description" class="mt-5 leading-relaxed text-muted"></p>
        <a
          data-field="link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-block rounded-full bg-gradient px-6 py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.03]"
        >Projekt ansehen</a>
      </div>
    </div>
  </div>
</div>

<script>
  import { initProjectModal } from "../scripts/modal.ts";
  initProjectModal();
</script>
