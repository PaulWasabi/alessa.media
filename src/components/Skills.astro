---
const skills = [
  "Video Editing", "Short-Form / Reels", "Animation", "Sounddesign",
  "Audioschnitt", "Color Grading", "Voiceover / Einsprechen",
  "Konzeption", "Storytelling", "Untertitel / Motion",
];
---
<section id="skills" class="mx-auto max-w-3xl px-6 text-center">
  <p class="reveal mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-faint">Was ich kann</p>
  <div class="flex flex-wrap justify-center gap-3">
    {skills.map((s) => (
      <span class="reveal rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold transition-colors hover:border-violet hover:text-violet">{s}</span>
    ))}
  </div>
</section>
