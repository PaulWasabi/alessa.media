---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Skills from "../components/Skills.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Work from "../components/Work.astro";
---
<Base>
  <Nav />
  <main>
    <div class="snap-panel"><Hero /></div>
    <div class="snap-panel flex flex-col justify-center"><Work /></div>
    <div class="snap-panel flex flex-col justify-center gap-12 bg-surface py-16">
      <About />
      <Skills />
    </div>
    <div class="snap-panel bg-gradient text-white flex flex-col">
      <Contact />
      <Footer />
    </div>
  </main>
</Base>
